# Durance proprietary material (tools, SDK, docs, dataset) - must not be published
vendor/
data/
*.zip
*.whl
*_sdk_installer.sh

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Training / build artifacts
*.pt
runs/
build-yocto/
install-yocto/
log/
kria-runtime.tar.gz

.DS_Store

# Our own recordings: event files are large, keep them out of git (share via drive)
recording/sessions/**/*.bin
recording/logs/
recording/previews/
logs/

# Noah's local layout: Durance material and upstream clones (same rule as vendor/)
docs/riversdk/
docs/*.pdf
starter/
third_party/

# Generated training set. Built WITHOUT the Durance dataset (--durance /nonexistent), so it
# contains only our own recordings, procedural clips and freely licensed videos.
# synth_train event files (GBs) are reproducible from their seeds: only previews are kept.
dataset/build/synth_train/*.bin
dataset/build/videos/reel_durance_train.mp4
dataset/build/durance_train/
runs/
