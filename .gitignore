# Durance proprietary material (tools, SDK, docs, dataset) - must not be published
vendor/
data/
*.zip
*.whl
*_sdk_installer.sh

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Training / build artifacts
*.pt
runs/
build-yocto/
install-yocto/
log/
kria-runtime.tar.gz

.DS_Store

# Our own recordings: event files are large, keep them out of git (share via drive)
recording/sessions/**/*.bin
recording/logs/
recording/previews/
logs/

# Noah's local layout: Durance material and upstream clones (same rule as vendor/)
docs/riversdk/
docs/*.pdf
starter/
third_party/

# Generated training set (large; partly derived from the proprietary Durance dataset).
# Rebuild with: uv run tools/build_dataset.py. Only the review videos are kept.
dataset/build/*
!dataset/build/videos/
dataset/build/videos/reel_durance_train.mp4
runs/
